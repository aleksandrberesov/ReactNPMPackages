{
  "compilerOptions": {
    "rootDir": "./src",              // <-- explicitly set source root
    "outDir": "./dist",              // compiled JS + .d.ts go here
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": false,
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "ESNext"
  },
  "include": ["src"]
}


